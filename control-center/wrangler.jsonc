{
  "name": "streamer-install-api",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-05",
  "account_id": "66717ff12038631dfc0a598918a5c91a",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "thtopppppp666.lat",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": false
  },
  "r2_buckets": [
    {
      "binding": "INSTALLERS",
      "bucket_name": "streamer-installers"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "streamer-install-tokens",
      "database_id": "22d8a8b4-263a-4187-83cf-c25e056f2422"
    }
  ],
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.ps1"
      ],
      "fallthrough": true
    }
  ],
  "vars": {
    "DOWNLOADS_ENABLED": "true",
    "EXE_OBJECT": "streamer-web-4102c5893c9d.exe",
    "EXE_SHA256": "4102c5893c9d367b80a425c88d520947f8b2e78698235f9d12a219c983c3ce3d",
    "INSTALL_API_ORIGIN": "https://streamer-install-api.babybadx7.workers.dev"
  },
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  }
}




