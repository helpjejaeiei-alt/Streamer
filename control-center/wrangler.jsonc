{
  "name": "streamer-install-api",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-05",
  "account_id": "66717ff12038631dfc0a598918a5c91a",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": false
  },
  "r2_buckets": [
    {
      "binding": "INSTALLERS",
      "bucket_name": "streamer-installers"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "streamer-install-tokens",
      "database_id": "22d8a8b4-263a-4187-83cf-c25e056f2422"
    }
  ],
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.ps1"
      ],
      "fallthrough": true
    }
  ],
  "vars": {
    "DOWNLOADS_ENABLED": "true",
    "EXE_OBJECT": "streamer-web-1930d7e01cad.exe",
    "EXE_SHA256": "1930d7e01cadff7e4ee4bd9a6a062293b235f7ae779fd026848287b2d42d30aa"
  },
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  }
}