{
  "name": "streamer-install-api",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-05",
  "account_id": "66717ff12038631dfc0a598918a5c91a",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "thtopppppp666.lat",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": false
  },
  "r2_buckets": [
    {
      "binding": "INSTALLERS",
      "bucket_name": "streamer-installers"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "streamer-install-tokens",
      "database_id": "22d8a8b4-263a-4187-83cf-c25e056f2422"
    }
  ],
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.ps1"
      ],
      "fallthrough": true
    }
  ],
  "vars": {
    "DOWNLOADS_ENABLED": "true",
    "EXE_OBJECT": "streamer-web-8ca0789869ae.exe",
    "EXE_SHA256": "8ca0789869ae6cc29c2941a9f1d9df100c4c515aa5d059016e07c90745ec6d9b",
    "INSTALL_API_ORIGIN": "https://streamer-install-api.babybadx7.workers.dev"
  },
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  }
}

